# Copia este archivo como .env.local y completa los valores.

# URL pública del portal (metadatos, Open Graph y sitemap). Ej.: https://dominio-definitivo (pendiente)
SITE_URL=http://localhost:3000

# URL base de plataforma-api (solo la usa el servidor de Next.js / BFF). Si está definida, el
# ingreso, el registro, el perfil y los documentos van a la API; si se deja vacía, el portal
# usa la autenticación simulada (como en el despliegue de demostración).
# API de desarrollo: https://plataforma-pdul-api-693924722323.us-central1.run.app/api/v1
API_URL=

# Credenciales del portal registradas en la plataforma (el seed usa portal-iribarren).
# Nunca uses el prefijo NEXT_PUBLIC_ ni las expongas al navegador. El secreto es opcional.
PORTAL_CLIENT_ID=portal-iribarren
PORTAL_CLIENT_SECRET=

# Solo desarrollo: retraso simulado (ms) de los datos de ejemplo para ver los skeletons.
MOCK_DELAY_MS=

# Secreto para firmar o cifrar la cookie de sesión (simulada o con la API). En Netlify: una cadena larga aleatoria.
SESION_SECRETO=

# Despliegue de demostración: registro sin el paso del correo, enlaces en pantalla y cinta de demo.
DEMO=
