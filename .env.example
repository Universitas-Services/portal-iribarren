# Copia este archivo como .env.local y completa los valores.

# URL pública del portal (metadatos, Open Graph y sitemap). Ej.: https://dominio-definitivo (pendiente)
SITE_URL=http://localhost:3000

# URL base de plataforma-api (solo la usa el servidor de Next.js / BFF).
API_URL=http://localhost:4000/api/v1

# Credenciales del portal registradas en la plataforma.
# Son secretas: nunca uses el prefijo NEXT_PUBLIC_ ni las expongas al navegador.
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=

# Solo desarrollo: retraso simulado (ms) de los datos de ejemplo para ver los skeletons.
MOCK_DELAY_MS=

# Secreto para firmar la cookie de sesión (autenticación simulada). En Netlify: una cadena larga aleatoria.
SESION_SECRETO=

# Despliegue de demostración: registro sin el paso del correo, enlaces en pantalla y cinta de demo.
DEMO=
